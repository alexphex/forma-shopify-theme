<section class="forma-hero">
  <div class="forma-hero__content">
    {% if section.settings.heading != blank %}
      <h1>{{ section.settings.heading }}</h1>
    {% endif %}

    {% if section.settings.text != blank %}
      <p>{{ section.settings.text }}</p>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link }}" class="forma-hero__button">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</section>

<style>
  .forma-hero {
    min-height: 650px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: #EAE3D9;
    padding: 40px 20px;
  }

  .forma-hero__content {
    max-width: 700px;
  }

  .forma-hero h1 {
    font-size: 64px;
    margin: 0 0 20px;
    color: #1A1A18;
  }

  .forma-hero p {
    font-size: 18px;
    margin-bottom: 30px;
    color: #1A1A18;
  }

  .forma-hero__button {
    display: inline-block;
    padding: 14px 32px;
    background: #1A1A18;
    color: #FBF9F5;
    text-decoration: none;
  }

  @media screen and (max-width: 749px) {
    .forma-hero h1 {
      font-size: 38px;
    }
  }
</style>

{% schema %}
{
  "name": "FORMA Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed for living"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Timeless furniture for modern spaces."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "FORMA Hero"
    }
  ]
}
{% endschema %}