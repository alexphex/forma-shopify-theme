<section class="forma-bestsellers">
  <div class="forma-bestsellers__inner">

    <div class="forma-bestsellers__header">
      <div>
        <p class="forma-bestsellers__eyebrow">CURATED FOR YOU</p>
        <h2>{{ section.settings.heading }}</h2>
      </div>

      {% if section.settings.collection != blank %}
        <a href="{{ section.settings.collection.url }}">
          View all
        </a>
      {% endif %}
    </div>

    {% if section.settings.collection != blank %}
      <div class="forma-bestsellers__grid">
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
          <div class="forma-bestsellers__card">

            <a href="{{ product.url }}" class="forma-bestsellers__image">
              {% if product.featured_image != blank %}
                {{
                  product.featured_image
                  | image_url: width: 800
                  | image_tag: loading: 'lazy'
                }}
              {% endif %}
            </a>

            <div class="forma-bestsellers__info">
              <h3>
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>

              <p>{{ product.price | money }}</p>
            </div>

          </div>
        {% endfor %}
      </div>
    {% else %}
      <p class="forma-bestsellers__empty">
        Select a collection in the section settings.
      </p>
    {% endif %}

  </div>
</section>

<style>
  .forma-bestsellers {
    padding: 80px 40px;
    background: #FBF9F5;
  }

  .forma-bestsellers__inner {
    max-width: 1400px;
    margin: 0 auto;
  }

  .forma-bestsellers__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 35px;
  }

  .forma-bestsellers__eyebrow {
    font-size: 11px;
    letter-spacing: 2px;
    color: #8C6747;
    margin-bottom: 12px;
  }

  .forma-bestsellers__header h2 {
    font-size: 36px;
    color: #1A1A18;
    margin: 0;
  }

  .forma-bestsellers__header > a {
    color: #1A1A18;
    text-decoration: none;
    border-bottom: 1px solid #8C6747;
    padding-bottom: 5px;
  }

  .forma-bestsellers__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .forma-bestsellers__image {
    display: block;
    background: #EAE3D9;
    overflow: hidden;
  }

  .forma-bestsellers__image img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .forma-bestsellers__image:hover img {
    transform: scale(1.04);
  }

  .forma-bestsellers__info {
    padding-top: 15px;
  }

  .forma-bestsellers__info h3 {
    font-size: 16px;
    margin: 0 0 8px;
  }

  .forma-bestsellers__info h3 a {
    color: #1A1A18;
    text-decoration: none;
  }

  .forma-bestsellers__info p {
    font-size: 14px;
    color: #8C6747;
    margin: 0;
  }

  .forma-bestsellers__empty {
    padding: 40px;
    text-align: center;
    background: #EAE3D9;
  }

  @media screen and (max-width: 749px) {
    .forma-bestsellers {
      padding: 50px 20px;
    }

    .forma-bestsellers__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px 12px;
    }

    .forma-bestsellers__header h2 {
      font-size: 28px;
    }
  }
</style>

{% schema %}
{
  "name": "FORMA Bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bestsellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "FORMA Bestsellers"
    }
  ]
}
{% endschema %}